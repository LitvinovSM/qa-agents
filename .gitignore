# .gitignore — что git НЕ должен добавлять в репозиторий (как target/ в Maven-проекте).

# Виртуальное окружение: создаётся командой `uv sync`, у каждого своё.
.venv/

# Кеш скомпилированного Python-кода (аналог .class-файлов).
__pycache__/
*.pyc

# Кеши инструментов.
.pytest_cache/
.ruff_cache/

# Настройки IDE.
.idea/

# Файл с секретами (ключи API и т.п.). НИКОГДА не коммитим.
.env
